rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isInstitutionalAccount() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.email.matches('.*@cetis50cdmx\\.com$')
          || request.auth.token.email.matches('.*@cetis50cdmx\\.edu\\.mx$')
        );
    }

    function isPublicAnnouncement() {
      return resource.data.category in ['general', 'eventos', 'vinculacion'];
    }

    function isAlumnosAnnouncement() {
      return resource.data.category == 'alumnos';
    }

    match /announcements/{docId} {
      // Lectura pública solo para categorías públicas.
      allow read: if isPublicAnnouncement()
        || (isAlumnosAnnouncement() && isInstitutionalAccount());

      // Mantén aquí tus permisos de escritura existentes.
      // Ejemplo común:
      // allow create, update, delete: if request.auth != null;
    }
  }
}
